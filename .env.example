# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Load order: real environment variables > .env.local > .env.

# Origin of the demo web trader, e.g. https://<broker>.aquariux.com
BASE_URL=

# Demo trading account (virtual funds). Never commit real values.
# Wrap the password in single quotes if it contains '#', otherwise dotenv treats the rest as a comment.
TRADER_USERNAME=
TRADER_PASSWORD=

# Instrument used by trading tests when a test does not pick its own.
DEFAULT_SYMBOL=EURUSD
